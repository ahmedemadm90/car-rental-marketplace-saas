APP_NAME=VoyagerRent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=voyagerrent
DB_USERNAME=voyagerrent
DB_PASSWORD=voyagerrent

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=voyagerrent

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@voyagerrent.test
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=43200
JWT_BLACKLIST_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
SMS_PROVIDER=
SMS_PROVIDER_TOKEN=
WHATSAPP_PROVIDER=
WHATSAPP_PROVIDER_TOKEN=
FIREBASE_CREDENTIALS_JSON=
MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
